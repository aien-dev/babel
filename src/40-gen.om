note diff/<name>/oracle.c: the original function text verbatim plus the shared driver
text PDiff "diff/"
text POrc "/oracle.c"
text POmd "/driver.om"
fn genoracle u ulong to void
m = mark
bs GOr1
fpath get Ufi u
bs Colon
bu get Ul0 u
bs Dash
bu get Ul1 u
bs GOr2
bpl get Ut0 u get Utn u
bdrvmainn u
w = woutn m PDiff u POrc
end

fn bdrvmainn u ulong to void
k = get Uar u
bs GOr3
bu k
bs GOr4
bname u
bs LPar
bargs ArgAk ArgXe k
bs GOr5
end

fn fpath fi ulong to void
bpl get F0 fi get Fl fi
end

note diff/<name>/driver.om: the lowered unit (omega/<name>.om) followed by a program-mode main
fn genomdrv u ulong to bool
m = mark
bouts DOmega
bname u
bs ExOm
e = mark
r = rfile m e
reset m
if lt r 0
ret false
end
bfb 0 get Fn 0
bs GOm1
k = get Uar u
for i ulong k
bs ArgA
bu i
bs GOm2
end
bs GOm3
bpl get Uw0 u get Uwn u
for i ulong k
bs Space
bs ArgA
bu i
end
bs NL
bs GOm4
w = woutn m PDiff u POmd
ret true
end
