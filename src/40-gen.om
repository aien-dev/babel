note babel 40-gen: target packaging, differential drivers and generated tests.
note Adapter outputs are stored verbatim under units/; everything here is babel glue: re-exports
note under the source names, drivers that read "id n" then n vectors and print one result per line,
note and tests whose expected values are the original C function's outputs.
global Cv ulong 1
global Co ulong 1
text Comma ", "
text ArgA "a"
text ArgX "x["
text ArgXe "]"
text GRs1 "[package]\nname = \""
text GRs2 "\"\nversion = \"0.1.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n[[bin]]\nname = \"babel_diff\"\npath = \"src/bin/babel_diff.rs\"\n"
text GRsL "//! Generated by babel. Every `units/<name>.rs` is the verbatim output of the omega-mv\n//! `rust-export` adapter (profile S1, c17-uint64-pure-v1); this file only re-exports\n//! each adapter function `calc` under its source name. See ../REPORT.md.\n\n"
text GRsM1 "#[path = \"units/"
text GRsM2 ".rs\"]\npub mod "
text GRsM3 ";\npub use "
text GRsM4 "::calc as "
text GRsM5 ";\n\n"
text GRsB1 "//! Generated by babel: differential driver.\n//! stdin: \"id n\" then n vectors of decimal u64; stdout: one result per line.\nuse std::io::Read;\n\nfn take(it: &mut std::str::SplitAsciiWhitespace<'_>) -> u64 {\n    it.next().expect(\"vector value\").parse().expect(\"u64\")\n}\n\nfn main() {\n    let mut s = String::new();\n    std::io::stdin().read_to_string(&mut s).expect(\"stdin\");\n    let mut it = s.split_ascii_whitespace();\n    let id: u64 = match it.next() {\n        Some(t) => t.parse().expect(\"id\"),\n        None => return,\n    };\n    let n = take(&mut it);\n    let mut out = String::new();\n    for _ in 0..n {\n        let r: u64 = match id {\n"
text GRsB2 " => {\n"
text GRsB3 "                let a"
text GRsB4 " = take(&mut it);\n"
text GRsB5 "                "
text GRsB6 "\n            }\n"
text GRsB7 "            _ => panic!(\"unknown unit id {id}\"),\n        };\n        out.push_str(&r.to_string());\n        out.push('\\n');\n    }\n    print!(\"{out}\");\n}\n"
text Ind12 "            "
text Ind8 "        "
text GRsT0 "//! Generated by babel: the expected values are the outputs of the ORIGINAL C functions\n//! (compiled by cc from the input, verbatim) on the vectors in ../diff/<name>/vectors.txt.\n"
text GRsT1 "\n#[test]\nfn "
text GRsT2 "_matches_original_c() {\n    let cases: &[(&[u64], u64)] = &[\n"
text GRsT3 "    ];\n    for (a, want) in cases {\n        assert_eq!("
text GRsT4 ", *want, \"inputs {:?}\", a);\n    }\n}\n"
text GRsC1 "(&["
text GRsC2 "], "
text GRsC3 "),\n"
text Dc2 "::"
text LPar "("
text RPar ")"
text GPyI1 "\"\"\"Generated by babel. Each units/<name>.py is the verbatim output of the omega-mv\npython-export adapter (profile S1); this file only re-exports `calc` under the source name.\"\"\"\n\n"
text GPyI2 "from .units."
text GPyI3 " import calc as "
text GPyI4 "\n__all__ = [\n"
text GPyI5 "    \""
text GPyI6 "\",\n"
text GPyI7 "]\n"
text GPyU "\"\"\"Verbatim python-export adapter outputs (see ../../REPORT.md).\"\"\"\n"
text GPyD1 "\"\"\"Generated by babel: differential driver.\n\nstdin: \"id n\" then n vectors of decimal u64; stdout: one result per line.\n\"\"\"\nimport sys\n\nimport "
text GPyD2 "\n\nUNITS = {\n"
text GPyD3 "    "
text GPyD4 ": ("
text GPyD5 "),\n"
text GPyD6 "}\n\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    fn, k = UNITS[int(data[0])]\n    n = int(data[1])\n    pos = 2\n    out = []\n    for _ in range(n):\n        args = [int(x) for x in data[pos:pos + k]]\n        pos += k\n        out.append(\"%d\\n\" % fn(*args))\n    sys.stdout.write(\"\".join(out))\n\n\nmain()\n"
text Dot "."
text GPyT1 "\"\"\"Generated by babel: expected values are the outputs of the ORIGINAL C functions\n(compiled by cc from the input, verbatim) on the vectors in ../diff/<name>/vectors.txt.\n\"\"\"\nimport unittest\n\nimport "
text GPyT2 "\n\n\nclass Differential(unittest.TestCase):\n"
text GPyT3 "    def test_"
text GPyT4 "(self):\n        cases = [\n"
text GPyT5 "        ]\n        for args, want in cases:\n            self.assertEqual("
text GPyT6 "(*args), want, args)\n\n"
text GPyT7 "\nif __name__ == \"__main__\":\n    unittest.main()\n"
text GPyC1 "            (("
text GPyC2 "), "
text GPyC3 "),\n"
text CommaO ","
text GCh1 "/* Generated by babel: prototypes of the verbatim c-export adapter outputs in units/. */\n#ifndef BABEL_GENERATED_H\n#define BABEL_GENERATED_H\n#include <stdint.h>\n\n"
text GCh2 "uint64_t "
text GCh3 "("
text GChV "void"
text GChU "uint64_t"
text GCh4 ");\n"
text GCh5 "\n#endif\n"
text GCd1 "/* Generated by babel: differential driver.\n * stdin: \"id n\" then n vectors of decimal u64; stdout: one result per line. */\n#include <stdio.h>\n#include \""
text GCd2 ".h\"\n\nint main(void) {\n    unsigned long long id, n, a[6] = {0};\n    if (scanf(\"%llu %llu\", &id, &n) != 2) return 0;\n    for (unsigned long long i = 0; i < n; i++) {\n        uint64_t r;\n        switch (id) {\n"
text GCd3 "        case "
text GCd4 ": {\n            for (int k = 0; k < "
text GCd5 "; k++) if (scanf(\"%llu\", &a[k]) != 1) return 2;\n            r = "
text GCd6 ");\n            break;\n        }\n"
text GCd7 "        default: return 3;\n        }\n        printf(\"%llu\\n\", (unsigned long long)r);\n    }\n    return 0;\n}\n"
text ArgAk "a["
text GOr1 "/* Generated by babel: differential oracle. The function below is the ORIGINAL C source,\n * verbatim from "
text GOr2 ", followed by a driver.\n * stdin: \"id n\" then n vectors of decimal u64; stdout: one result per line. */\n#include <stdint.h>\n#include <stdio.h>\n\n"
text GOr3 "\n\nint main(void) {\n    unsigned long long id, n, a[6] = {0};\n    if (scanf(\"%llu %llu\", &id, &n) != 2) return 0;\n    (void)id;\n    for (unsigned long long i = 0; i < n; i++) {\n        for (int k = 0; k < "
text GOr4 "; k++) if (scanf(\"%llu\", &a[k]) != 1) return 2;\n        printf(\"%llu\\n\", (unsigned long long)"
text GOr5 "));\n    }\n    return 0;\n}\n"
text GCp1 "// Generated by babel: differential driver for one verbatim cpp-export output.\n// stdin: \"id n\" then n vectors of decimal u64; stdout: one result per line.\n#include <stdio.h>\n#include \"../units/"
text GCp2 ".cpp\"\n"
text Colon ":"
text Dash "-"
text Calc "calc"
text GZl1 "//! Generated by babel: re-exports the verbatim zig-export outputs in units/ under source names.\n"
text GZl2 "pub const "
text GZl3 " = @import(\"units/"
text GZl4 ".zig\").calc;\n"
text GZd1 "//! Generated by babel: differential driver.\n//! stdin: \"id n\" then n vectors of decimal u64; stdout: one result per line.\nconst lib = @import(\"lib.zig\");\nextern \"c\" fn scanf(fmt: [*:0]const u8, ...) c_int;\nextern \"c\" fn printf(fmt: [*:0]const u8, ...) c_int;\n\npub fn main() void {\n    var id: u64 = 0;\n    var n: u64 = 0;\n    if (scanf(\"%llu %llu\", &id, &n) != 2) return;\n    var x: [6]u64 = .{ 0, 0, 0, 0, 0, 0 };\n    _ = &x;\n    var i: u64 = 0;\n    while (i < n) : (i += 1) {\n        const r: u64 = switch (id) {\n"
text GZd2 " => blk: {\n                for (0.."
text GZd3 ") |k| {\n                    if (scanf(\"%llu\", &x[k]) != 1) return;\n                }\n                break :blk lib."
text GZd4 ");\n            },\n"
text GZd5 "            else => return,\n        };\n        _ = printf(\"%llu\\n\", r);\n    }\n}\n"
text GGm1 "module "
text GGm2 "\n\ngo 1.22\n"
text GGd1 "// Code generated by babel. DO NOT EDIT.\n// Differential driver for the verbatim go-export output in calc.go.\n// stdin: \"id n\" then n vectors of decimal u64; stdout: one result per line.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"os\"\n)\n\nfunc main() {\n\tin := bufio.NewReader(os.Stdin)\n\tout := bufio.NewWriter(os.Stdout)\n\tdefer out.Flush()\n\tvar id, n uint64\n\tif _, err := fmt.Fscan(in, &id, &n); err != nil {\n\t\treturn\n\t}\n\tvar x [6]uint64\n\tfor i := uint64(0); i < n; i++ {\n\t\tfor k := 0; k < "
text GGd2 "; k++ {\n\t\t\tif _, err := fmt.Fscan(in, &x[k]); err != nil {\n\t\t\t\tos.Exit(2)\n\t\t\t}\n\t\t}\n\t\tfmt.Fprintln(out, calc("
text GGd3 "))\n\t}\n}\n"
text GOm1 "\nnote babel differential driver: reads \"id n\" then n vectors of decimal ulong, prints one result per line\nglobal BbIn uchar 1048576\nglobal BbOut uchar 1048576\nglobal BbPos ulong 1\nglobal BbLen ulong 1\nglobal BbOl ulong 1\nfn babel_next to ulong\np = get BbPos 0\nn = get BbLen 0\nwhile lt p n bound 999999\nc = get BbIn p\nif ge c 48\nif le c 57\nbreak\nend\nend\np = add p 1\nend\nv = ulong 0\nwhile lt p n bound 64\nc = get BbIn p\nif lt c 48\nbreak\nend\nif gt c 57\nbreak\nend\nv = add mul v 10 ulong sub c 48\np = add p 1\nend\nput BbPos 0 p\nret v\nend\nfn babel_put v ulong to void\nd = new uchar 24 0\nk = ulong 0\nx = v\nwhile true bound 30\nput d k uchar add 48 rem x 10\nk = add k 1\nx = div x 10\nif eq x 0\nbreak\nend\nend\no = get BbOl 0\nwhile gt k 0 bound 30\nk = sub k 1\nput BbOut o get d k\no = add o 1\nend\nput BbOut o 10\nput BbOl 0 add o 1\nend\nfn main to int\nn = ulong 0\nwhile lt n len BbIn bound 999999\nr = read 0 BbIn n sub len BbIn n\nif le r 0\nbreak\nend\nn = add n ulong r\nend\nput BbLen 0 n\nix = babel_next\ncnt = babel_next\nfor j ulong cnt\n"
text GOm2 " = babel_next\n"
text GOm3 "r = "
text GOm4 "babel_put r\nend\nw = write 1 BbOut 0 get BbOl 0\nret 0\nend\n"
text Space " "

note "pre0<sep>pre1..." for k arguments, with a closing text after each index
note (omc 2c824805 passes a garbage length for an empty text, so there is no empty-post form)
fn bargs pre view uchar * post view uchar * k ulong to void
for i ulong k
if gt i 0
bs Comma
end
bs pre
bu i
bs post
end
end

fn bargs0 pre view uchar * k ulong to void
for i ulong k
if gt i 0
bs Comma
end
bs pre
bu i
end
end

fn bpkg to void
bpl get Pg0 0 get Pgn 0
end

note write the arena from m to the file <out>/<s>; resets the arena to m
fn wout m ulong s view uchar * to long
c = mark
bouts s
p = mark
r = wfile m c c p
reset m
ret r
end

note same with <out>/<s><name><t>
fn woutn m ulong s view uchar * u ulong t view uchar * to long
c = mark
bouts s
bname u
bs t
p = mark
r = wfile m c c p
reset m
ret r
end

fn exported u ulong to bool
ret eq get Ust u 7
end

text PCargo "rust/Cargo.toml"
text PRsLib "rust/src/lib.rs"
text PRsBin "rust/src/bin/babel_diff.rs"
text PRsTst "rust/tests/differential.rs"

fn genrust to void
m = mark
bs GRs1
bpkg
bs GRs2
w = wout m PCargo
bs GRsL
for u ulong get Nu 0
if exported u
bs GRsM1
bname u
bs GRsM2
bname u
bs GRsM3
bname u
bs GRsM4
bname u
bs GRsM5
end
end
w = wout m PRsLib
bs GRsB1
for u ulong get Nu 0
if exported u
k = get Uar u
bs Ind12
bu get Uid u
bs GRsB2
for i ulong k
bs GRsB3
bu i
bs GRsB4
end
bs GRsB5
bpkg
bs Dc2
bname u
bs LPar
bargs0 ArgA k
bs RPar
bs GRsB6
end
end
bs GRsB7
w = wout m PRsBin
end


note one generated case per vector: rust "(&[a, b], r),", python "((a, b), r),"
fn bcases u ulong py bool to void
put Cv 0 get Uv0 u
put Co 0 get Uo0 u
ve = add get Uv0 u get Uvn u
oe = add get Uo0 u get Uon u
skipln ve
k = get Uar u
for j ulong get Unv u
bcase k py ve oe
end
end

fn bcase k ulong py bool ve ulong oe ulong to void
if py
bs GPyC1
else
bs Ind8
bs GRsC1
end
v = get Cv 0
e = lnend v ve
for i ulong sub e v
c = get Pl add v i
if eq c 32
bs Comma
else
bc c
end
end
if py
if eq k 1
bs CommaO
end
bs GPyC2
else
bs GRsC2
end
put Cv 0 add e 1
o = get Co 0
f = lnend o oe
bpl o sub f o
put Co 0 add f 1
if py
bs GPyC3
else
bs GRsC3
end
end

fn lnend o ulong e ulong to ulong
i = o
while lt i e bound 999999
if eq get Pl i 10
ret i
end
i = add i 1
end
ret e
end

fn skipln e ulong to void
put Cv 0 add lnend get Cv 0 e 1
end

note tests may only use vectors whose oracle run succeeded (Uon > 0)
fn hascases u ulong to bool
ret gt get Uon u 0
end

fn anycase to bool
for u ulong get Nu 0
if hascases u
ret true
end
end
ret false
end

fn genrstest to void
m = mark
bs GRsT0
for u ulong get Nu 0
if hascases u
bs GRsT1
bname u
bs GRsT2
bcases u false
bs GRsT3
bpkg
bs Dc2
bname u
bs LPar
bargs ArgAk ArgXe get Uar u
bs RPar
bs GRsT4
end
end
w = wout m PRsTst
end

text PPyMain "python/babel_diff.py"
text PPyTst "python/test_differential.py"
text PInit "/__init__.py"
text PUInit "/units/__init__.py"

fn genpy to void
m = mark
bs GPyI1
for u ulong get Nu 0
if exported u
bs GPyI2
bname u
bs GPyI3
bname u
bs NL
end
end
bs GPyI4
for u ulong get Nu 0
if exported u
bs GPyI5
bname u
bs GPyI6
end
end
bs GPyI7
pyfile m PInit
bs GPyU
pyfile m PUInit
bs GPyD1
bpkg
bs GPyD2
for u ulong get Nu 0
if exported u
bs GPyD3
bu get Uid u
bs GPyD4
bpkg
bs Dot
bname u
bs Comma
bu get Uar u
bs GPyD5
end
end
bs GPyD6
w = wout m PPyMain
end

note write the arena from m to <out>/python/<pkg><s>
fn pyfile m ulong s view uchar * to void
c = mark
bouts DPy
bpkg
bs s
p = mark
r = wfile m c c p
reset m
end

fn genpytest to void
m = mark
bs GPyT1
bpkg
bs GPyT2
for u ulong get Nu 0
if hascases u
bs GPyT3
bname u
bs GPyT4
bcases u true
bs GPyT5
bpkg
bs Dot
bname u
bs GPyT6
end
end
bs GPyT7
w = wout m PPyTst
end

text PCMain "c/babel_diff.c"
text PCDir "c/"
text ExHdr ".h"

fn genc to void
m = mark
bs GCh1
for u ulong get Nu 0
if exported u
bs GCh2
bpl get Ua0 u get Uan u
bs GCh3
k = get Uar u
if eq k 0
bs GChV
end
for i ulong k
if gt i 0
bs Comma
end
bs GChU
end
bs GCh4
end
end
bs GCh5
c = mark
bouts PCDir
bpkg
bs ExHdr
p = mark
w = wfile m c c p
reset m
bs GCd1
bpkg
bs GCd2
for u ulong get Nu 0
if exported u
bs GCd3
bu get Uid u
bs GCd4
bu get Uar u
bs GCd5
bpl get Ua0 u get Uan u
bs LPar
bargs ArgAk ArgXe get Uar u
bs GCd6
end
end
bs GCd7
w = wout m PCMain
end

note per-unit C++ driver cpp/diff/<name>.cpp
text PCpD "cpp/diff/"
fn gencpp to void
for u ulong get Nu 0
if exported u
m = mark
bs GCp1
bname u
bs GCp2
bdrvmain get Uar u Calc
w = woutn m PCpD u Ext_cp
end
end
end

note the shared single-function C/C++ main used by the oracle and the C++ drivers
fn bdrvmain k ulong fname view uchar * to void
bs GOr3
bu k
bs GOr4
bs fname
bs LPar
bargs ArgAk ArgXe k
bs GOr5
end

