text PGoMod "go/go.mod"
text PGoMain "/main.go"
fn gengo to void
m = mark
bs GGm1
bpkg
bs GGm2
w = wout m PGoMod
for u ulong get Nu 0
if exported u
bs GGd1
bu get Uar u
bs GGd2
